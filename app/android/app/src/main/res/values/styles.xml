<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动瞬间的窗口样式：必须有背景色，否则冷启动会闪一下黑/白 -->
    <style name="LaunchTheme" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="NormalTheme" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
